# Settings for `docker compose up` (copy to .env; .env is git-ignored).
#
# Running WITHOUT Docker? Use the per-app files instead:
#   services/api/.env.example   (FastAPI: database and token verification)
#   apps/web/.env.example       (Next.js: public Supabase URL and key)
# Where every value comes from: docs/SUPABASE_SETUP.md

# API log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Web origin(s) the API accepts browser requests from (comma-separated, no path).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Browser-facing API address, compiled into the web app. Public by design: never a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=StudyPilot

# --- Supabase: public values (safe to expose to the browser) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: SERVER SECRETS (API container only; never commit real values) --------------------
# Session-pooler connection string with ?sslmode=require. Contains the database password.
DATABASE_URL=
# Same project URL as above (the API reads it as SUPABASE_URL).
SUPABASE_URL=
# jwks (default) for projects with asymmetric signing keys; hs256 for legacy projects.
SUPABASE_JWT_MODE=jwks
# Only with SUPABASE_JWT_MODE=hs256 (at least 32 characters).
SUPABASE_JWT_SECRET=
