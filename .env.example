# Optional overrides for `docker compose up` (copy to .env; .env is git-ignored).
# Compose already has working local defaults, so you only need this file to change them.
#
# Per-app settings for running WITHOUT Docker live in:
#   services/api/.env.example   (FastAPI)
#   apps/web/.env.example       (Next.js)

# API log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Web origin(s) the API accepts browser requests from (comma-separated, no path).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Browser-facing API address, compiled into the web app. Public by design: never a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=StudyPilot
