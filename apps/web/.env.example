# Copy to .env.local for local development (.env.local is git-ignored).
#
# Only NEXT_PUBLIC_* values are sent to the browser. They are public by design:
# never put a secret, key or token in a NEXT_PUBLIC_ variable. In particular the Supabase
# service-role / secret key must NEVER appear anywhere in this app.
#
# Where to find each value: docs/SUPABASE_SETUP.md

# Product name shown in the UI. Optional (default: StudyPilot).
NEXT_PUBLIC_APP_NAME=StudyPilot

# Base URL of the FastAPI service as reachable from the BROWSER.
# Optional in development (default: http://localhost:8000); REQUIRED for production builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Your Supabase project URL (Dashboard > Project Settings > API). Local CLI stack:
# http://127.0.0.1:54321. Optional in development (sign-in then says auth is not configured);
# REQUIRED for production builds. Must be set together with the publishable key.
NEXT_PUBLIC_SUPABASE_URL=

# The project's PUBLISHABLE key (sb_publishable_...), or the legacy "anon" key on older
# projects. It only identifies the project to Supabase Auth; Row Level Security and the API's
# token checks are what protect the data. Local CLI stack: `npx supabase status` prints it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Where server-rendered pages reach the API. Needed when it differs from the
# browser URL, for example in Docker Compose where the service is reachable as http://api:8000.
# Optional (default: NEXT_PUBLIC_API_BASE_URL).
# API_INTERNAL_BASE_URL=http://api:8000
