# Copy to services/api/.env for local development (.env is git-ignored).
# Every variable is optional locally; the defaults below are what you get without a file.
# Invalid values stop the API at startup with a message naming the variable (never its value).

# local | test | staging | production
# In production: interactive docs (/docs, /openapi.json) are disabled and logs are JSON.
APP_ENV=local

# Product name reported by /healthz.
APP_NAME=StudyPilot

# Reported by /healthz. Set from the release/commit in deployed environments.
APP_VERSION=0.1.0

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of web origins allowed to call the API from a browser.
# Scheme and host only (no path). Must be https:// in staging and production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Added by later milestones (see docs/ARCHITECTURE.md §12): DATABASE_URL, SUPABASE_*, LLM keys.
# Those are secrets: they belong only in a local .env or your host's secret store, never in Git.
