# Copy to services/api/.env for local development (.env is git-ignored).
# Invalid or missing values stop the API at startup with a message naming the variable (never its
# value). Step-by-step setup, including where to find each value: docs/SUPABASE_SETUP.md

# local | test | staging | production
# In production: interactive docs (/docs, /openapi.json) are disabled and logs are JSON.
# In staging and production the API also insists on https origins and sslmode=require.
APP_ENV=local

# Product name reported by /healthz.
APP_NAME=StudyPilot

# Reported by /healthz. Set from the release/commit in deployed environments.
APP_VERSION=0.1.0

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of web origins allowed to call the API from a browser.
# Scheme and host only (no path). Must be https:// in staging and production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------------------------
# Supabase (REQUIRED outside tests)
# ---------------------------------------------------------------------------------------------

# SECRET. Postgres connection string of your Supabase project. It contains the database
# password, so it lives only here or in your host's secret store, never in Git or the browser.
# Use the SESSION POOLER string from Dashboard > Connect (it works over IPv4), and keep
# "?sslmode=require" (mandatory in staging and production). Hosted example shape:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local Supabase CLI stack (`npx supabase start`):
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Public project URL: Dashboard > Project Settings > API. Local CLI stack: http://127.0.0.1:54321
SUPABASE_URL=

# How access tokens are verified.
#   jwks  (default) Projects with asymmetric JWT signing keys: the API fetches the public keys
#         from {SUPABASE_URL}/auth/v1/.well-known/jwks.json. No secret is needed.
#   hs256 Legacy shared-secret projects and the local Supabase CLI stack. Requires
#         SUPABASE_JWT_SECRET below.
SUPABASE_JWT_MODE=jwks

# SECRET, only for SUPABASE_JWT_MODE=hs256 (at least 32 characters). Anyone holding it can mint
# a token for any user. Local CLI stack: the JWT_SECRET line of `npx supabase status -o env`.
SUPABASE_JWT_SECRET=

# Rarely needed overrides (defaults are derived from SUPABASE_URL):
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------------------------------------
# Tuning (optional)
# ---------------------------------------------------------------------------------------------
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT_SECONDS=5
# MAX_ACTIVE_GOALS_PER_USER=50

# Never configure the Supabase service-role / secret key for this API: it is not used, and it
# would bypass Row Level Security. LLM provider keys arrive with the AI milestone and are
# secrets of the same kind.
